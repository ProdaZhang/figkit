{
 "_note": "前两个事件由 flow_from_figma.py 从 nodes.json 的 interactions[] 导进来(figma 原稿画的两条线);其余是 figma 表达不了的应用语义,手写。motion 块由 make_fixture.py 跑 motion.apply_defaults 补出来,别手改。",
 "stage": {
  "w": 1080,
  "h": 1920
 },
 "caps": {
  "main": "screen-main.ui.json",
  "bag": "screen-bag.ui.json",
  "codex": "screen-codex.ui.json"
 },
 "base": "main",
 "modals": {
  "bag": {
   "cap": "bag",
   "roots": [
    "4:10"
   ],
   "panel": "4:10"
  },
  "codex": {
   "cap": "codex",
   "roots": [
    "5:10"
   ],
   "panel": "5:10"
  }
 },
 "state": {
  "unlocked": false
 },
 "events": [
  {
   "on": "click",
   "el": "1:52",
   "do": "openModal",
   "arg": "bag",
   "transition": {
    "type": "MOVE_IN",
    "duration": 300,
    "direction": "BOTTOM",
    "easing": {
     "type": "CUSTOM_CUBIC_BEZIER",
     "bezier": [
      0.32,
      0.72,
      0,
      1
     ]
    }
   }
  },
  {
   "on": "click",
   "el": "1:56",
   "do": "openModal",
   "arg": "codex",
   "transition": {
    "type": "DISSOLVE",
    "duration": 260,
    "easing": {
     "type": "EASE_OUT"
    }
   }
  },
  {
   "on": "click",
   "el": "@in:bag:4:12",
   "do": "closeModal",
   "transition": {
    "type": "SCALE_OUT",
    "duration": 180,
    "toScale": 0.95,
    "easing": {
     "type": "CUSTOM_CUBIC_BEZIER",
     "bezier": [
      0.23,
      1,
      0.32,
      1
     ]
    },
    "source": "preset:base"
   }
  },
  {
   "on": "click",
   "el": "1:30",
   "do": "claim"
  },
  {
   "on": "click",
   "el": [
    "1:50",
    "1:58"
   ],
   "guard": [
    "unlocked"
   ],
   "do": "send",
   "arg": "OpenLocked"
  },
  {
   "on": "click",
   "el": "@panelOutside:bag",
   "do": "closeModal",
   "transition": {
    "type": "SCALE_OUT",
    "duration": 180,
    "toScale": 0.95,
    "easing": {
     "type": "CUSTOM_CUBIC_BEZIER",
     "bezier": [
      0.23,
      1,
      0.32,
      1
     ]
    },
    "source": "preset:base"
   }
  },
  {
   "on": "click",
   "el": "@panelOutside:codex",
   "do": "closeModal",
   "transition": {
    "type": "SCALE_OUT",
    "duration": 180,
    "toScale": 0.95,
    "easing": {
     "type": "CUSTOM_CUBIC_BEZIER",
     "bezier": [
      0.23,
      1,
      0.32,
      1
     ]
    },
    "source": "preset:base"
   }
  }
 ],
 "list": {
  "modal": "codex",
  "container": "5:20",
  "onRowClick": "selectEntry"
 },
 "motion": {
  "preset": "base",
  "press": {
   "scale": 0.96,
   "duration": 120,
   "easing": {
    "type": "CUSTOM_CUBIC_BEZIER",
    "bezier": [
     0.23,
     1,
     0.32,
     1
    ]
   },
   "source": "preset:base"
  },
  "stagger": {
   "step": 45,
   "duration": 260,
   "from": 24,
   "easing": {
    "type": "CUSTOM_CUBIC_BEZIER",
    "bezier": [
     0.32,
     0.72,
     0,
     1
    ]
   },
   "source": "preset:base"
  },
  "guardFail": {
   "effect": "wiggle",
   "amp": 6,
   "duration": 120,
   "source": "preset:base"
  }
 }
}
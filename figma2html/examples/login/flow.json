{
  "stage": {
    "w": 1080,
    "h": 1920
  },
  "caps": {
    "base": "screen-login.ui.json",
    "notice": "screen-notice.ui.json",
    "serverlist": "screen-serverlist.ui.json"
  },
  "base": "base",
  "modals": {
    "notice": {
      "cap": "notice",
      "roots": [
        "2:10"
      ],
      "panel": "2:10"
    },
    "serverlist": {
      "cap": "serverlist",
      "roots": [
        "3:10"
      ],
      "panel": "3:10"
    }
  },
  "state": {
    "agreed": false,
    "selected": null
  },
  "events": [
    {
      "on": "click",
      "el": "1:40",
      "do": "openModal",
      "arg": "notice",
      "transition": {
        "type": "DISSOLVE",
        "duration": 260,
        "easing": {
          "type": "EASE_OUT"
        }
      }
    },
    {
      "on": "click",
      "el": [
        "1:10",
        "1:13"
      ],
      "do": "openModal",
      "arg": "serverlist",
      "transition": {
        "type": "MOVE_IN",
        "duration": 300,
        "direction": "BOTTOM",
        "easing": {
          "type": "CUSTOM_CUBIC_BEZIER",
          "bezier": [
            0.32,
            0.72,
            0,
            1
          ]
        }
      }
    },
    {
      "on": "click",
      "el": "1:30",
      "do": "toggleFlag",
      "arg": "agreed"
    },
    {
      "on": "click",
      "el": "1:20",
      "guard": [
        "agreed",
        "selected"
      ],
      "do": "send",
      "arg": "Enter"
    },
    {
      "on": "click",
      "el": "@panelOutside:serverlist",
      "do": "closeModal",
      "transition": {
        "type": "SCALE_OUT",
        "duration": 180,
        "toScale": 0.95,
        "easing": {
          "type": "CUSTOM_CUBIC_BEZIER",
          "bezier": [
            0.23,
            1,
            0.32,
            1
          ]
        },
        "source": "preset:base"
      }
    },
    {
      "on": "click",
      "el": "@any:notice",
      "do": "closeModal",
      "transition": {
        "type": "SCALE_OUT",
        "duration": 180,
        "toScale": 0.95,
        "easing": {
          "type": "CUSTOM_CUBIC_BEZIER",
          "bezier": [
            0.23,
            1,
            0.32,
            1
          ]
        },
        "source": "preset:base"
      }
    }
  ],
  "list": {
    "modal": "serverlist",
    "container": "3:20",
    "onRowClick": "selectServer"
  },
  "bindings": {
    "checkbox": {
      "el": "1:30",
      "flag": "agreed",
      "checkedBg": "rgba(255,255,255,1)",
      "uncheckedBg": "rgba(255,255,255,0.2)",
      "mark": "✓",
      "markColor": "rgba(27,76,87,1)"
    }
  },
  "motion": {
    "preset": "base",
    "press": {
      "scale": 0.96,
      "duration": 120,
      "easing": {
        "type": "CUSTOM_CUBIC_BEZIER",
        "bezier": [
          0.23,
          1,
          0.32,
          1
        ]
      },
      "source": "preset:base"
    },
    "stagger": {
      "step": 45,
      "duration": 260,
      "from": 24,
      "easing": {
        "type": "CUSTOM_CUBIC_BEZIER",
        "bezier": [
          0.32,
          0.72,
          0,
          1
        ]
      },
      "source": "preset:base"
    },
    "guardFail": {
      "effect": "wiggle",
      "amp": 6,
      "duration": 120,
      "source": "preset:base"
    }
  }
}

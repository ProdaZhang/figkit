/* screen-login.uss — ui_to_unity.py 生成(源 frame 1:1,1080x1920,确定性输出无时间戳)。
 * 选择器 = .el-<name> 类(name 可能以数字开头,#id 选择器会非法)。
 * known-loss —— 本文件相对 IR 丢弃/降级的项(诚实降级,勿静默):
 *   - 1:3: font-family 'Source Han Sans SC' 未映射(Unity 需 FontAsset,见 mapping.md)
 *   - 1:40: font-weight 500 近似为 normal(USS 只有 normal/bold)
 *   - 1:40: font-family 'Source Han Sans SC' 未映射(Unity 需 FontAsset,见 mapping.md)
 *   - 1:11: font-weight 500 近似为 normal(USS 只有 normal/bold)
 *   - 1:11: font-family 'Source Han Sans SC' 未映射(Unity 需 FontAsset,见 mapping.md)
 *   - 1:13: font-weight 500 近似为 normal(USS 只有 normal/bold)
 *   - 1:13: font-family 'Source Han Sans SC' 未映射(Unity 需 FontAsset,见 mapping.md)
 *   - 1:21: font-weight 800 近似为 bold(USS 只有 normal/bold)
 *   - 1:21: font-family 'Source Han Sans SC' 未映射(Unity 需 FontAsset,见 mapping.md)
 *   - 1:31: font-family 'Source Han Sans SC' 未映射(Unity 需 FontAsset,见 mapping.md)
 */

.screen-root {
  position: absolute;
  left: 0;
  top: 0;
  width: 1080px;
  height: 1920px;
  overflow: hidden;
  background-color: rgba(20,50,59,1);
}

.el-1_3 {
  position: absolute;
  left: 0px;
  top: 260px;
  width: 1080px;
  height: 110px;
  margin: 0;
  padding: 0;
  color: rgba(255,255,255,1);
  font-size: 88px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
  white-space: nowrap;
  overflow: visible;
}

.el-1_40 {
  position: absolute;
  left: 900px;
  top: 80px;
  width: 140px;
  height: 48px;
  margin: 0;
  padding: 0;
  color: rgba(255,215,106,1);
  font-size: 36px;
  -unity-font-style: normal;
  -unity-text-align: middle-center;
  white-space: nowrap;
  overflow: visible;
}


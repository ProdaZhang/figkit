{
  "_why": [
    "跨后端一致性的声明表。每个特性由 kitchen-sink 里的一个元素承载,每个后端必须为它",
    "声明一种处置方式,测试再去产物里核对声明是否属实。",
    "此前没有这层:各后端只跟自己手写的期望比,谁都不知道别人怎么解同一份 IR ——",
    "capture 对每个 ELLIPSE 都产的 radius:'50%' 因此在 godot 被整个丢掉、在 cocos 被",
    "当成 50px,而两边的测试都是绿的。"
  ],
  "_status_meaning": {
    "render": "产物用引擎自己的词汇表达了它 —— 检测器必须在产物里找到信号",
    "approx": "表达了,但是有记录在案的近似 —— 必须找到信号,且必须有降级说明",
    "known-loss": "刻意不表达 —— 产物里必须找不到信号,且必须有降级说明留痕",
    "carry": "仅 unreal:python 段是预处理器,原样带进 uespec,取舍在 C++ 运行时"
  },
  "_scope": [
    "在测范围内的是三个**产物型**后端(godot/unity/unreal)。figma2html 与 figma2cocos 是",
    "**解释器**:直接在运行时吃 .ui.json,没有可静态检查的产物,不在本套内 ——",
    "它们分别由自己的渲染测试与 runtime 源码守卫覆盖。这是本套已知的覆盖边界。"
  ],
  "_structural_why": [
    "身份与几何 —— 没有'各后端怎么处置'的余地,不需要逐后端声明。",
    "**新增 IR 字段要么进 _structural,要么进 features 并配一个真用得上它的 kitchen-sink 元素**;",
    "两边都没有 = test_every_ir_field_is_accounted_for 直接红。v1.2 的 paths/clip/borderAlign",
    "当初就是从这个缝里掉下去的:字段加了、夹具里全是空值、无人声明,于是四个后端集体",
    "静默丢弃,而全套测试一路绿灯。"
  ],
  "_structural": ["id", "name", "type", "parent", "x", "y", "w", "h", "z"],
  "features": {
    "radius-px": {
      "el": "k:radius-px", "field": "radius", "doc": "radius",
      "godot": "render", "unity": "render", "unreal": "carry"
    },
    "radius-pct": {
      "el": "k:radius-pct", "field": "radius", "doc": "50%",
      "godot": "render", "unity": "render", "unreal": "carry"
    },
    "radius-pct-oblong": {
      "el": "k:radius-pct-oblong", "field": "radius", "doc": "50%",
      "godot": "approx", "unity": "render", "unreal": "carry"
    },
    "border": {
      "el": "k:border", "field": "border", "doc": "border",
      "godot": "render", "unity": "render", "unreal": "carry"
    },
    "shadow": {
      "el": "k:shadow", "field": "shadow", "doc": "shadow",
      "godot": "approx", "unity": "known-loss", "unreal": "carry"
    },
    "blur": {
      "el": "k:blur", "field": "blur", "doc": "blur",
      "godot": "known-loss", "unity": "known-loss", "unreal": "carry"
    },
    "rot": {
      "el": "k:rot", "field": "rot", "doc": "rot",
      "godot": "render", "unity": "render", "unreal": "carry"
    },
    "opacity": {
      "el": "k:opacity", "field": "opacity", "doc": "opacity",
